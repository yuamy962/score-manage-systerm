                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </div>
            </div>
          </div>

          {userReview && (
            <div className="mt-6 rounded-xl bg-white p-6 shadow-md border border-gray-100">
              <h3 className="text-sm font-semibold text-gray-700 mb-2">🤖 绩效评语</h3>
              <div className="text-sm text-gray-600 whitespace-pre-wrap bg-gray-50 rounded-lg p-4">
                {userReview.content}
              </div>
              <div className="mt-2 flex items-center gap-2">
                <span className={`inline-flex rounded-full px-2 py-0.5 text-xs font-semibold ${
                  userReview.status === 'PUBLISHED' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'
                }`}>
                  {userReview.status === 'PUBLISHED' ? '已下发' : '草稿'}
                </span>
                {userReview.publishedAt && (
                  <span className="text-xs text-gray-400">{new Date(userReview.publishedAt).toLocaleDateString('zh-CN')} 下发</span>
                )}
              </div>
            </div>
          )}

          {userHistory && (
            <div className="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
              <HistoryLineChart
                title={`📈 ${new Date().getFullYear()}年积分趋势`}
                data={userHistory.scores.map((s: any) => ({ label: s.month.slice(5), value: s.score, grade: s.grade }))}
                color="#2563eb"
                fillColor="rgba(37, 99, 235, 0.1)"
                unit="分"
              />
              <HistoryLineChart
                title={`🏆 ${new Date().getFullYear()}年排名趋势`}
                data={userHistory.rankings.map((r: any) => ({ label: r.month.slice(5), value: r.rank, grade: undefined }))}
                color="#16a34a"
                fillColor="rgba(22, 163, 74, 0.1)"
                unit="名"
                reverseY
              />
            </div>
          )}
        </div>
      )}
    </div>
  );
}
